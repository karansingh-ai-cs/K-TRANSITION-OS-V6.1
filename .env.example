# .env.example — K-Transition OS v6.0
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Groq API Key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Cloud Database ─────────────────────────────────────────────────
# Turso (free at https://turso.tech) — leave blank to use local SQLite
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_TOKEN=your_turso_auth_token

# ── Optional: Settings ───────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# DB_FILE=ktransition.db
# PORT=10000

# ── Optional: Negotiator Voice ───────────────────────────────────────────────
# USE_ORPHEUS_TTS=true
# ORPHEUS_MODEL=orpheus-3b-0.1-ft-q4_k_m
